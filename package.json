{
  "name": "rosetta-date-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "description": "Workspace root for rosetta-date — the library, its playground, and the docs site.",
  "author": "João Pedro Antunes Silva <hi@joaopedroas.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter=rosetta-date",
    "dev": "turbo run dev --filter=rosetta-date",
    "test": "turbo run test --filter=rosetta-date",
    "test:watch": "turbo run test:watch --filter=rosetta-date",
    "test:coverage": "turbo run test:coverage --filter=rosetta-date",
    "typecheck": "turbo run typecheck --filter=rosetta-date",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "playground": "turbo run dev --filter=@rosetta-date/playground",
    "playground:build": "turbo run build --filter=@rosetta-date/playground",
    "docs:dev": "turbo run dev --filter=@rosetta-date/docs",
    "docs:build": "turbo run build --filter=@rosetta-date/docs",
    "release": "pnpm --filter rosetta-date build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-markdown-preferences": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
